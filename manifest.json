{
  "manifest_version": 3,
  "name": "CleanMark - AI Watermark Remover (Images & Videos)",
  "version": "1.0.0",
  "description": "Remove Gemini, stock, logo, and text watermarks from images and videos of any resolution with zero quality loss.",
  "permissions": [
    "contextMenus",
    "storage",
    "activeTab",
    "downloads"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "CleanMark Watermark Remover"
  },
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content/content.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "studio/studio.html",
        "icons/*",
        "lib/*"
      ],
      "matches": ["<all_urls>"]
    }
  ]
}
